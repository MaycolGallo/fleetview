{
  "entities": {
    "Vehicle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vehicle",
      "type": "object",
      "description": "Represents a vehicle in the fleet.",
      "properties": {
        "vehicleId": {
          "type": "string",
          "description": "Unique identifier for the vehicle."
        },
        "latitude": {
          "type": "number",
          "description": "The current latitude of the vehicle."
        },
        "longitude": {
          "type": "number",
          "description": "The current longitude of the vehicle."
        },
        "status": {
          "type": "string",
          "description": "The current status of the vehicle (e.g., active, idle, out-of-service)."
        },
        "driverName": {
          "type": "string"
        },
        "speedKph": {
          "type": "number"
        },
        "fuelLevel": {
          "type": "number"
        },
        "lastMaintenance": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "vehicleId",
        "latitude",
        "longitude",
        "status",
        "driverName",
        "speedKph",
        "fuelLevel",
        "lastMaintenance"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": {
        "$ref": "#/entities/Vehicle"
      },
      "description": "Stores individual vehicle data. This collection is publicly readable by any authenticated user but is not writable from the client."
    }
  }
}
